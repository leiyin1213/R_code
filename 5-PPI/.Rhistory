chr_num = gsub("chr","", chr)
idx = match(chr_num, c(1:22,"X","Y"))
circos.rect(
CELL_META$xlim[1], 0,
CELL_META$xlim[2], 1,
col = chr_colors[idx],
border = NA
)
}
)
